{
  "name": "signalk-derived-engine-state",
  "version": "0.1.0",
  "displayName": "Derived Engine State",
  "description": "Infers propulsion.<instance>.state (started/stopped) from alternator temperature and house charge current, for boats with no NMEA 2000 engine data.",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "backfill-run.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha",
    "lint": "eslint ."
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility"
  ],
  "signalk-plugin-enabled-by-default": false,
  "author": "Johan Solve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johansolve/signalk-derived-engine-state.git"
  },
  "bugs": {
    "url": "https://github.com/johansolve/signalk-derived-engine-state/issues"
  },
  "homepage": "https://github.com/johansolve/signalk-derived-engine-state#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.0"
  }
}
